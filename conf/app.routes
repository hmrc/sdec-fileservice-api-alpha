# microservice specific routes
-> /hmrc-frontend hmrcfrontend.Routes
GET  /assets/*file   controllers.Assets.versioned(path="/public", file: Asset)
GET  /health-check    uk.gov.hmrc.sdecfileserviceapialpha.controllers.HealthCheckController.healthCheckResponse
GET  /file-upload          uk.gov.hmrc.sdecfileserviceapialpha.controllers.fileupload.FileUploader.onPageLoad
GET  /file-upload-complete uk.gov.hmrc.sdecfileserviceapialpha.controllers.fileupload.FileUploader.uploadComplete

GET     /multipart-upload uk.gov.hmrc.sdecfileserviceapialpha.controllers.fileupload.MultipartFileUploader.showUploadPage
POST    /multipart-upload/initiate uk.gov.hmrc.sdecfileserviceapialpha.controllers.fileupload.MultipartFileUploader.initiateMultipartUpload
POST    /multipart-upload/complete uk.gov.hmrc.sdecfileserviceapialpha.controllers.fileupload.MultipartFileUploader.completeMultipartUpload
GET     /multipart-upload/complete uk.gov.hmrc.sdecfileserviceapialpha.controllers.fileupload.MultipartFileUploader.uploadComplete
